# Non-secret local defaults
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=pbl_audit
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000
SIWE_CHAIN_ID=84532
COOKIE_SECURE=false

# Populate only through scripts/setup_keys.py. Never commit real values.
SESSION_SECRET_BASE64=
PAYLOAD_MASTER_KEY_BASE64=
INTERNAL_SERVICE_TOKEN=
ADMIN_SERVICE_TOKEN=
GATEWAY_SERVICE_TOKEN=
COMMERCE_GATEWAY_URL=http://localhost:8081
SELLER_ROUTES_JSON={"gemini":"http://localhost:8080","nemotron":"http://localhost:8082"}
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# User-owned AEGIS ERC-3009 contract on Base Sepolia; old onchain PBLC is distinct.
TOKEN_ADDRESS=0x3440294d5fdc4849461c6f383a7fcf89af0c4a4b
QUOTE_VERIFYING_CONTRACT=
DECISION_VERIFYING_CONTRACT=
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
EVIDENCE_ANCHOR_ADDRESS=
GEMINI_MODEL_ID=gemini-2.5-flash
GEMINI_MODEL_VERSION=gemini-2.5-flash
NEMOTRON_MODEL_ID=nvidia/llama-3.3-nemotron-super-49b-v1.5
NEMOTRON_MODEL_VERSION=nvidia/llama-3.3-nemotron-super-49b-v1.5
PROVIDER_MODE=mock
MOCK_PROVIDER_PREFIX=mock

# aa-three-factor-v1. Without AA_API_KEY the buyer uses the checked-in AA fixture pages
# and records mode=fixture. Set the server-only key plus an exact configured catalog to
# enable a live AA snapshot; each exact model mapping still must be configured.
AA_API_KEY=
# Only set alongside a live-mapped catalog file; a fixture catalog cannot be read live.
AA_MODEL_CATALOG_PATH=
# standard-answer-v1. This maximum is part of every quoted one-task prepayment.
AEGIS_MAX_OUTPUT_TOKENS=8000
# AEGIS contract (PBLC variable names retained for compatibility). `live` mode uses
# an external Facilitator; Mock Provider responses remain visibly mocked.
PBLC_TOKEN_ADDRESS=0x3440294d5fdc4849461c6f383a7fcf89af0c4a4b
PBLC_TOKEN_STATUS=deployed-base-sepolia
PAYMENT_TOKEN_NAME=AEGIS
PAYMENT_TOKEN_SYMBOL=AEGIS
PAYMENT_TOKEN_VERSION=1
AEGIS_PRIORITY_CLASSIFIER=local-qwen
AEGIS_OLLAMA_URL=http://127.0.0.1:11434
AEGIS_OLLAMA_MODEL=qwen3.5:4b
AEGIS_OLLAMA_TIMEOUT_SECONDS=30
# Single-user local demo owner. Server configuration, never a browser-selected identity.
# Clear it only to run the historical SIWE composition for reading PBLC history.
AEGIS_LOCAL_OWNER_ADDRESS=0x00000000000000000000000000000000000a6e15
AEGIS_LOCAL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AEGIS_LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1
# `mock` uses an ephemeral signer and local Mock Facilitator. `live` uses only
# PBLC_USER_PRIVATE_KEY, requires AEGIS_REAL_PAYMENT_APPROVED=yes, and can transfer
# PBLC through the configured external Facilitator.
AEGIS_EXECUTION_MODE=mock
AEGIS_REAL_PAYMENT_APPROVED=
# Provider Gateway / payment execution module wiring. npm run aegis:stack generates its
# own ports, tokens and an ephemeral signing key, so these are only for a manual launch.
AEGIS_NETWORK=eip155:84532
AEGIS_FACILITATOR_URL=http://127.0.0.1:8095
# Optional server-only Authorization header for a hosted Facilitator such as CDP.
AEGIS_FACILITATOR_AUTHORIZATION=
AEGIS_GATEWAY_ROUTES_JSON={"openai":"http://127.0.0.1:8091","anthropic":"http://127.0.0.1:8092","google":"http://127.0.0.1:8093"}
AEGIS_PROVIDER_ID=
# Ephemeral test key only. Never a real wallet key, and never committed.
AEGIS_SIGNER_PRIVATE_KEY=
# Separate user-owned PBLC deployment. Set the key only with
# scripts/set_pblc_user_wallet_key.sh; the deployer must match this public address.
PBLC_USER_ADDRESS=0x043D966B3f30Ff9FAC08FD6b5eFeDa6ac895a0a3
PBLC_USER_PRIVATE_KEY=

# Generated locally by scripts/setup_keys.py. Never paste keys into chat.
DEPLOYER_PRIVATE_KEY=
GEMINI_SELLER_PRIVATE_KEY=
NEMOTRON_SELLER_PRIVATE_KEY=
BUYER_AGENT_PRIVATE_KEY=

# Enter later through the local secret handoff only; never commit real values.
GEMINI_API_KEY=
NVIDIA_API_KEY=
FACILITATOR_URL=https://x402.org/facilitator
FACILITATOR_AUTHORIZATION=
GEMINI_ERC8004_AGENT_ID=
NEMOTRON_ERC8004_AGENT_ID=
GEMINI_PAY_TO_ADDRESS=
NEMOTRON_PAY_TO_ADDRESS=
